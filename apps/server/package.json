{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx --watch ./src/index.ts",
    "build": "pnpm --filter emails build && tsdown",
    "format": "prettier --write \"**/*.{ts,md,json,js,yaml}\"",
    "gen:docs": "NODE_OPTIONS='--max-old-space-size=4096' typedoc",
    "check:lint": "eslint . --cache --cache-location node_modules/.cache/eslint/ --max-warnings 1000",
    "fix:lint": "eslint . --cache --cache-location node_modules/.cache/eslint/ --fix --max-warnings=1000",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio --verbose",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx ./src/database/seeds/index.ts",
    "test": "vitest",
    "check:types": "node ./node_modules/typescript-7/bin/tsc --noEmit",
    "clean": "rm -rf node_modules dist docs && echo 'Cleanup complete!'"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6"
  }
}
