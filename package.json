{
  "name": "my-turborepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --concurrency=30",
    "check:lint": "turbo run check:lint",
    "fix:lint": "turbo run fix:lint",
    "check:types": "turbo run check:types",
    "format": "prettier --write \"**/*.{ts,tsx,json,css}\"",
    "gen:docs": "turbo run gen:docs",
    "gen:docs-all": "NODE_OPTIONS='--max-old-space-size=4096' typedoc",
    "clean": "turbo run clean && rm -rf node_modules dist docs .turbo && echo 'Root Cleanup complete!'",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "commit": "git-cz",
    "prepare": "husky"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/cz-commitlint": "^21.2.2",
    "@commitlint/prompt-cli": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "commitizen": "^4.3.2",
    "commitlint-plugin-tense": "^1.0.10",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "3.9.6",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "turbo": "^2.10.13",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@^7.0.2"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "husky": "^9.1.7",
    "inversify": "^8.2.3",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.6.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
